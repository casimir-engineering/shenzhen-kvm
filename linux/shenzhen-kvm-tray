# ---------------------------------------------------------------------------------------------
# Words
# ---------------------------------------------------------------------------------------------
def size_text(b):
    b = int(b)
    if b >= 1 << 30:
        return "%.1f GB" % (b / float(1 << 30))
    if b >= 1 << 20:
        return "%.1f MB" % (b / float(1 << 20))
    if b >= 1024:
        return "%d KB" % (b >> 10)
    return "%d bytes" % b


def esc(s):
    return GLib.markup_escape_text(s or "")


class Peer:
    """The other computer's name, for the middle of a sentence and for its start."""

    def __init__(self, name):
        self.name = name or ""

    @property
    def mid(self):
        return self.name or "the other computer"

    @property
    def start(self):
        return self.name or "The other computer"


def window_status(st, refused):
    if st is None:
        return refused or NOT_RUNNING
    p = Peer(st.get("peer_name"))
    s = st.get("settings") or {}
    if not st.get("linked"):
        return "Not linked with another computer yet."
    if not s.get("sharing", True):
        return "Sharing is off: your keyboard, mouse and clipboard stay on this computer."
    mode = st.get("mode")
    if mode == "driving":
        return "The mouse is on %s." % p.mid
    if mode == "driven":
        return "%s's keyboard and mouse are in use here." % p.start
    if st.get("online"):
        return "The mouse is on this computer. %s is connected." % p.start
    return "The mouse is on this computer. %s is not answering: check that it is on and on the same network." % p.start


def short_status(st, refused):
    if st is None:
        return refused or NOT_RUNNING
    p = Peer(st.get("peer_name"))
    s = st.get("settings") or {}
    if not st.get("linked"):
        return "Not linked yet"
    mode = st.get("mode")
    if mode == "driving":
        return "Mouse is on %s" % p.mid
    if mode == "driven":
        return "Mouse is on this computer (%s's mouse)" % p.mid
    if not s.get("sharing", True):
        return "Sharing is off"
    if st.get("online"):
        return "Mouse is on this computer · %s connected" % p.mid
    return "Mouse is on this computer · %s not answering" % p.mid


def direction(t, p):
    return ("This computer → %s" % p.mid) if t.get("dir") == "out" else ("%s → this computer" % p.start)


def fraction(t):
    total, done = t.get("total") or 0, t.get("done") or 0
    if total > 0:
        return min(1.0, float(done) / total)
    return 1.0 if t.get("state") == "done" else 0.0


# ---------------------------------------------------------------------------------------------
# Tray glyphs, drawn without cairo: signed distances, anti-aliased by coverage
# ---------------------------------------------------------------------------------------------
def _sd_box(px, py, x0, y0, x1, y1, r):
    cx, cy, hw, hh = (x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2
    qx, qy = abs(px - cx) - hw + r, abs(py - cy) - hh + r
    return math.hypot(max(qx, 0.0), max(qy, 0.0)) + min(max(qx, qy), 0.0) - r


def _sd_circle(px, py, cx, cy, r):
    return math.hypot(px - cx, py - cy) - r


def _sd_capsule(px, py, ax, ay, bx, by, r):
    pax, pay, bax, bay = px - ax, py - ay, bx - ax, by - ay
    h = max(0.0, min(1.0, (pax * bax + pay * bay) / (bax * bax + bay * bay or 1e-9)))
    return math.hypot(pax - bax * h, pay - bay * h) - r


def _keyboard_layout(width, x, y):
    """A keyboard on whole pixels (so it stays crisp at tray sizes), width pixels wide at most."""
    lw = 1 if width < 28 else 2 if width < 44 else int(round(width / 20.0))   # outline
    key = max(1, int(round(width / 11.0)))
    gap = max(1, int(round(width / 18.0)))
    n = max(3, min(6, (width - 2 - 2 * lw - gap) // (key + gap)))
    ow = gap + n * (key + gap) + 2 * lw
    oh = 4 * gap + 3 * key + 2 * lw
    x0 = x + (width - ow) // 2
    box = (x0, y, x0 + ow, y + oh)
    keys = []
    kx0, ky0 = x0 + lw + gap, y + lw + gap
    for row in range(2):
        for c in range(n):
            kx, ky = kx0 + c * (key + gap), ky0 + row * (key + gap)
            keys.append((kx, ky, kx + key, ky + key))
    sy = ky0 + 2 * (key + gap)
    keys.append((kx0 + (key + gap), sy, kx0 + (n - 1) * (key + gap) - gap, sy + key))
    return box, lw, keys


def _keyboard(px, py, layout, filled):
    box, lw, keys = layout
    r = lw + 0.6
    keys_d = min(_sd_box(px, py, k[0], k[1], k[2], k[3], 0.0) for k in keys)
    outer = _sd_box(px, py, box[0], box[1], box[2], box[3], r)
    if filled:
        return max(outer, -keys_d)
    inner = _sd_box(px, py, box[0] + lw, box[1] + lw, box[2] - lw, box[3] - lw, max(0.0, r - lw))
    return min(max(outer, -inner), keys_d)


def glyph_sdf(kind, s):
    if kind == "warning":
        lw = max(1.5, s * 0.085)
        a, b, c = (0.5 * s, 0.10 * s), (0.07 * s, 0.88 * s), (0.93 * s, 0.88 * s)

        def f(px, py):
            d = min(_sd_capsule(px, py, a[0], a[1], b[0], b[1], lw / 2),
                    _sd_capsule(px, py, b[0], b[1], c[0], c[1], lw / 2),
                    _sd_capsule(px, py, c[0], c[1], a[0], a[1], lw / 2))
            d = min(d, _sd_capsule(px, py, 0.5 * s, 0.40 * s, 0.5 * s, 0.60 * s, lw * 0.5))
            return min(d, _sd_circle(px, py, 0.5 * s, 0.74 * s, lw * 0.6))
        return f
    if kind == "badge":
        lay = _keyboard_layout(int(round(s * 0.84)), 0, int(round(s * 0.10)))
        br = s * 0.26
        bx = by = s - br - 0.25
        dot = max(0.7, s * 0.045)

        def f(px, py):
            kb = max(_keyboard(px, py, lay, False), -_sd_circle(px, py, bx, by, br + max(1.0, s * 0.07)))
            disk = _sd_circle(px, py, bx, by, br)
            dots = min(_sd_circle(px, py, bx + o * br * 0.5, by, dot) for o in (-1, 0, 1))
            return min(kb, max(disk, -dots))
        return f
    width = s - max(1, s // 12) * 2 + 1
    lay = _keyboard_layout(width, (s - width + 1) // 2, 0)
    h = lay[0][3] - lay[0][1]
    lay = _keyboard_layout(width, (s - width + 1) // 2, (s - h) // 2)
    filled = kind == "filled"
    return lambda px, py: _keyboard(px, py, lay, filled)


def draw_glyph(kind, size, rgba):
    """kind: outline | filled | badge | warning. Returns a GdkPixbuf of size x size in colour rgba."""
    s = max(8, int(size))
    f = glyph_sdf(kind, s)
    r, g, b = [int(round(max(0.0, min(1.0, c)) * 255)) for c in (rgba.red, rgba.green, rgba.blue)]
    a_max = max(0.0, min(1.0, rgba.alpha))
    buf = bytearray(s * s * 4)
    i = 0
    for y in range(s):
        for x in range(s):
            cov = 0.5 - f(x + 0.5, y + 0.5)
            cov = 0.0 if cov < 0 else 1.0 if cov > 1 else cov
            buf[i:i + 4] = bytes((r, g, b, int(cov * a_max * 255 + 0.5)))
            i += 4
    return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(buf)), GdkPixbuf.Colorspace.RGB, True, 8, s, s, s * 4)


# ---------------------------------------------------------------------------------------------
# The connection to the service
# ---------------------------------------------------------------------------------------------
class Service:
    def __init__(self, path, on_state, on_change, on_lost):
        self.path, self.on_state, self.on_change, self.on_lost = path, on_state, on_change, on_lost
        self.sock, self.watch, self.buf = None, None, b""
        self.refused = None          # the service's message when it does not let us in
        self.looking = False         # what we last told this connection
        self.want_look = False
        GLib.idle_add(self._try)

    @property
    def up(self):
        return self.sock is not None

    def _try(self):
        if self.sock:
            return False
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        try:
            s.connect(self.path)
        except OSError:
            s.close()
            GLib.timeout_add(1000, self._try)
            return False
        self.sock, self.buf, self.looking = s, b"", False
        self.watch = GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._readable)
        self.send({"cmd": "subscribe"})
        self.sync_look()
        return False

    def _down(self):
        if self.watch:
            GLib.source_remove(self.watch)
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock, self.watch, self.buf, self.looking = None, None, b"", False
        self.on_lost()
        GLib.timeout_add(5000 if self.refused else 1000, self._try)

    def _readable(self, fd, cond):
        try:
            data = self.sock.recv(65536)
        except (BlockingIOError, socket.timeout):
            return True
        except OSError:
            data = b""
        if not data:
            self.watch = None
            self._down()
            return False
        self.buf += data
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            try:
                msg = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if msg.get("type") == "error":
                self.refused = msg.get("message") or "Shenzhen KVM didn't let this app in."
                self.on_change()
            elif msg.get("type") == "state":
                self.refused = None
                self.on_state(msg)
        return True

    def send(self, obj):
        if not self.sock:
            return
        try:
            self.sock.sendall((json.dumps(obj) + "\n").encode())
        except OSError:
            pass

    def sync_look(self):
        if self.sock and self.want_look != self.looking:
            self.looking = self.want_look
            self.send({"cmd": "look", "on": self.want_look})

    def close(self):
        if self.sock:
            self.want_look = False
            self.sync_look()


# ---------------------------------------------------------------------------------------------
# Small widget helpers
# ---------------------------------------------------------------------------------------------
def label(text="", secondary=False, small=False, bold=False, wrap=True, markup=None):
    l = Gtk.Label()
    l.set_xalign(0)
    l.set_line_wrap(wrap)
    if wrap:
        l.set_line_wrap_mode(2)   # Pango.WrapMode.WORD_CHAR
        l.set_max_width_chars(1)   # the column's width decides where it wraps
    if secondary:
        l.get_style_context().add_class("dim-label")
    l._fmt = (small, bold)
    if markup is not None:
        l.set_markup(markup)
    else:
        set_text(l, text)
    return l


def set_text(l, text):
    small, bold = getattr(l, "_fmt", (False, False))
    m = esc(text)
    if bold:
        m = "<b>%s</b>" % m
    if small:
        m = "<small>%s</small>" % m
    if l.get_label() != m or not l.get_use_markup():
        l.set_markup(m)


def hbox(*kids, spacing=8):
    b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)
    for k in kids:
        b.pack_start(k, False, False, 0)
    return b


def vbox(spacing=10):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)


def wrap_check(text=""):
    c = Gtk.CheckButton()
    l = label(text)
    c.add(l)
    c._label = l
    return c


def show_if(w, on):
    if on and not w.get_visible():
        w.show()
    elif not on and w.get_visible():
        w.hide()


def app_icons():
    """The app icon at every size we ship: from the icon theme once installed, else next to this script."""
    theme = Gtk.IconTheme.get_default()
    if theme.has_icon("shenzhen-kvm"):
        return "shenzhen-kvm", []
    here = os.path.dirname(os.path.realpath(__file__))
    out = []
    for d in (os.path.join(here, "files", "icons"), "/usr/local/share/shenzhen-kvm/icons", "/usr/share/shenzhen-kvm/icons"):
        for n in (16, 24, 32, 48, 64, 128, 256):
            p = os.path.join(d, "shenzhen-kvm-%d.png" % n)
            if os.path.exists(p):
                try:
                    out.append(GdkPixbuf.Pixbuf.new_from_file(p))
                except GLib.Error:
                    pass
        if out:
            break
    return None, out


